AGENT_ENGINE=codeagent
HOST=127.0.0.1
PORT=3000
GATEWAY_DATABASE_PATH=./data/gateway.db
AGENT_ALLOWED_ROOTS=/absolute/path/to/projects
GATEWAY_API_KEY=replace-me
PERMISSION_POLICY=client
MAX_SESSIONS=100
MAX_CONCURRENT_RUNS=10
MAX_MESSAGES_PER_SESSION=200
GENERATION_TIMEOUT_MS=600000
IDLE_SESSION_TIMEOUT_MS=300000
EVENT_HISTORY_LIMIT=1000
LOG_LEVEL=info
